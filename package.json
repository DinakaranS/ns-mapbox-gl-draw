{
  "name": "ns-mapbox-gl-draw",
  "version": "2.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "A drawing component for Mapbox GL JS",
  "author": "Dinakaran S",
  "license": "ISC",
  "homepage": "https://github.com/DinakaranS/ns-mapbox-gl-draw",
  "repository": {
    "type": "git",
    "url": "git://github.com/DinakaranS/ns-mapbox-gl-draw.git"
  },
  "bugs": {
    "url": "https://github.com/DinakaranS/ns-mapbox-gl-draw/issues"
  },
  "keywords": [
    "webgl",
    "mapbox",
    "draw",
    "drawing",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mapbox-gl-draw.mjs",
      "require": "./dist/mapbox-gl-draw.cjs"
    },
    "./dist/mapbox-gl-draw.css": "./dist/mapbox-gl-draw.css"
  },
  "main": "dist/mapbox-gl-draw.cjs",
  "module": "dist/mapbox-gl-draw.mjs",
  "types": "dist/index.d.ts",
  "browser": "dist/mapbox-gl-draw.umd.js",
  "style": "dist/mapbox-gl-draw.css",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint index.ts src/",
    "lint:fix": "eslint index.ts src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"index.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"index.ts\"",
    "build": "vite build --config vite.build.config.ts",
    "prebuild": "yarn typecheck",
    "prepublishOnly": "yarn lint && yarn build",
    "test": "node example/runtime-test.mjs && node example/test-all-modes.mjs",
    "start": "vite example/ --host :: --open",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/geojson": "^7946.0.16",
    "@types/numeral": "^2.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "mapbox-gl": "^3.29.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@mapbox/geojson-area": "^0.2.2",
    "@mapbox/geojson-normalize": "^0.0.1",
    "@mapbox/point-geometry": "^1.1.0",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/center-of-mass": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/polygon-to-line": "^7.4.0",
    "@turf/projection": "^7.4.0",
    "fast-deep-equal": "^3.1.3",
    "nanoid": "^6.0.1",
    "numeral": "^2.0.6"
  },
  "peerDependencies": {
    "mapbox-gl": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    }
  },
  "files": [
    "src/**/*.ts",
    "index.ts",
    "dist/"
  ]
}
